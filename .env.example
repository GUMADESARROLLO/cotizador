APP_NAME=Cotizador
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_cotizador
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sac-app
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=https://s3.gumacorp.com
AWS_URL=https://s3.gumacorp.com/sac-app/
# Solo en desarrollo local si el certificado falla:
# AWS_SSL_VERIFY=false

VITE_APP_NAME="${APP_NAME}"

# --- Catálogo de artículos: SQL Server 2019 (solo lectura) ---
# ARTICULOS_DRIVER=demo usa datos de ejemplo sin conexión.
ARTICULOS_DRIVER=demo
DB_SQL_HOST_CONNECTION=sqlsrv
DB_SQL_HOST=127.0.0.1
DB_SQL_PORT=1433
DB_SQL_DATABASE=
DB_SQL_USERNAME=
DB_SQL_PASSWORD=
DB_SQL_ENCRYPT=yes
DB_SQL_TRUST_SERVER_CERTIFICATE=true


# --- Reorder Point de GUMA@NET (categoría y meses de inventario) ---
# SQL Server donde está PRODUCCION.dbo.fn_reorder_meses_inventario (solo lectura).
REORDER_ENABLED=true
DB_REORDER_HOST=
DB_REORDER_DATABASE=PRODUCCION
DB_REORDER_USERNAME=
DB_REORDER_PASSWORD=
# Vacía = hoy. Fijarla si la última foto de categorías no es confiable.
REORDER_FECHA_CORTE=
REORDER_REFRESCAR_MINUTOS=120
